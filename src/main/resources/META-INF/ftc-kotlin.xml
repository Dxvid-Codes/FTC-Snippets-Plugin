<idea-plugin>
    <!--
      Loaded only when the Kotlin plugin is installed. The Kotlin live templates live
      here because their KOTLIN context type is contributed by that plugin; keeping
      them out of the main descriptor means Java-only users are never forced to
      install Kotlin support.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <defaultLiveTemplates file="/liveTemplates/FTCSnippetsKotlin.xml"/>
    </extensions>

    <!-- Nothing here touches the Kotlin analysis API, so both the K1 and K2
         compiler modes are fine. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>
</idea-plugin>
